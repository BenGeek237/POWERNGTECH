# Environment variables for POWER NG TECHNOLOGIE Backend
# Copy this file to .env and fill in your values

# Django
SECRET_KEY=your-very-secret-key-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.dev

# Database PostgreSQL
DATABASE_URL=postgres://powerng_user:powerng_pass@localhost:5432/powerng_db

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7

# Media Files (local dev only — ignored when R2 is enabled)
MEDIA_URL=/media/
MEDIA_ROOT=media/

# Email (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=POWER NG TECHNOLOGIE <noreply@powerngtech.com>

# MonetBil (paiement mobile)
MONETBIL_SERVICE_KEY=your-monetbil-service-key
MONETBIL_SERVICE_SECRET=your-monetbil-service-secret
MONETBIL_NOTIFY_URL=http://localhost:8000/api/paiements/webhook/monetbil/
MONETBIL_RETURN_URL=http://localhost:5173/paiement/retour

# PawaPay
PAWAPAY_API_KEY=your-pawapay-api-key
PAWAPAY_BASE_URL=https://api.pawapay.cloud

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Cloudflare R2 Storage (production only)
# ---------------------------------------------------------------------------
# Get these from: Cloudflare Dashboard > R2 > Manage R2 API Tokens
USE_R2_STORAGE=False
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=powerngtech-media
R2_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_CUSTOM_DOMAIN=media.powerngtech.com
