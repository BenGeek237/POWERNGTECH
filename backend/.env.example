# Environment variables for POWER NG TECHNOLOGIE Backend
# Copy this file to .env and fill in your values

# Django
SECRET_KEY=your-very-secret-key-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database PostgreSQL
DATABASE_URL=postgres://powerng_user:powerng_pass@localhost:5432/powerng_db

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7

# Media Files
MEDIA_URL=/media/
MEDIA_ROOT=media/

# Email (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=POWER NG TECHNOLOGIE <noreply@powerngtech.com>

# CAMERPAY
CAMERPAY_API_KEY=your-camerpay-api-key
CAMERPAY_SECRET_KEY=your-camerpay-secret-key
CAMERPAY_BASE_URL=https://app.camerpay.com/api/v1
CAMERPAY_WEBHOOK_SECRET=your-webhook-secret

# CinetPay
CINETPAY_API_KEY=your-cinetpay-api-key
CINETPAY_SITE_ID=your-cinetpay-site-id
CINETPAY_SECRET_KEY=your-cinetpay-secret-key

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:5173
